{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/remind-gate-skills.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/deny-upstream-push.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/remind-gate-skills.sh"
          }
        ]
      }
    ]
  }
}
