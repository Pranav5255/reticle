---
import { readFileSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';
import Counter from '../components/Counter.tsx';
import ReticleDev from '../components/ReticleDev.tsx';

const pairingToken = (() => {
  if (!import.meta.env.DEV) return '';
  const dir = process.env['RETICLE_PAIRING_TOKEN_DIR'] || join(homedir(), '.reticle');
  try {
    return readFileSync(join(dir, 'pairing-token'), 'utf8').trim();
  } catch {
    return '';
  }
})();
const pairingRoot = import.meta.env.DEV ? process.cwd() : '';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Reticle × Astro</title>
    <meta name="reticle-pairing-token" content={pairingToken} />
    <meta name="reticle-pairing-root" content={pairingRoot} />
  </head>
  <body>
    <h1>Reticle × Astro</h1>
    <Counter client:load />
    {import.meta.env.DEV && <ReticleDev client:only="react" />}
  </body>
</html>
