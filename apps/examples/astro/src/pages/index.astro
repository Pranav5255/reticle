---
import { readFileSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';
import Counter from '../components/Counter.tsx';

const pairingToken = (() => {
  if (!import.meta.env.DEV) return '';
  const dir = process.env['RETICLE_PAIRING_TOKEN_DIR'] || join(homedir(), '.reticle');
  try {
    return readFileSync(join(dir, 'pairing-token'), 'utf8').trim();
  } catch {
    return '';
  }
})();
const pairingRoot = import.meta.env.DEV ? process.cwd() : '';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Reticle × Astro</title>
    <meta name="reticle-pairing-token" content={pairingToken} />
    <meta name="reticle-pairing-root" content={pairingRoot} />
  </head>
  <body>
    <h1>Reticle × Astro</h1>
    <Counter client:load />
    <script>
      if (import.meta.env.DEV) {
        const token =
          document.querySelector('meta[name="reticle-pairing-token"]')?.getAttribute('content') ??
          '';
        const root =
          document.querySelector('meta[name="reticle-pairing-root"]')?.getAttribute('content') ?? '';
        if (token.length === 0) {
          console.warn(
            '[reticle] no pairing token was available when this page rendered, so the app will connect and be refused — you will see NO SESSION even though the SDK loads and the socket opens. The token is written by the Reticle daemon: start it (`reticle serve`, or let your agent start it) and reload this page.',
          );
        }
        let sdk;
        for (let attempt = 0; attempt < 15; attempt++) {
          try {
            sdk = await import('@reticlehq/react');
            break;
          } catch {
            await new Promise((r) => setTimeout(r, 200));
          }
        }
        if (!sdk) {
          throw new Error('[reticle] @reticlehq/react failed to load');
        }
        const { reticle, install } = sdk;
        install();
        reticle.connect({
          projectId: 'example-astro',
          ...(token.length > 0 ? { token } : {}),
          ...(root.length > 0 ? { root } : {}),
        });
      }
    </script>
  </body>
</html>
